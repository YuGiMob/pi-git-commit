{
  "name": "pi-git-commit",
  "version": "1.1.4",
  "type": "module",
  "description": "Pi extension: block mutative git commands in bash and provide git_commit and git_amend tools plus /commit, /amend, /stop-commit and /toggle-allow-git commands",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuGiMob/pi-git-commit.git"
  },
  "author": "YuGiMob",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "extension",
    "git",
    "commit",
    "guard"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.0",
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9",
    "typebox": "^1.3.7"
  }
}
